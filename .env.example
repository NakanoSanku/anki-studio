# Google OAuth / Sheets sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required comma-separated allowlist; an empty value denies every account.
GOOGLE_ALLOWED_EMAILS=you@example.com
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Public production URL, e.g. https://anki.example.com
NEXTAUTH_URL=http://localhost:3000

# Image hosting proxy (K-Vault)
MEDIA_UPLOAD_ENDPOINT=https://k-vault.kaiton.dev/api/v1/upload
MEDIA_UPLOAD_STORAGE=telegram
